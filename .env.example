# Copy to .env.local and fill in (see docs/SETUP_SUPABASE.md).
# Local:  npx supabase status -o env  → API_URL / ANON_KEY
# Cloud:  Dashboard → Project Settings → API Keys (publishable or anon key, never the secret key)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: receipt scanning (/scan)
GEMINI_API_KEY=
