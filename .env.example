# Copy to .env.local and fill in (see docs/SETUP_SUPABASE.md).
# Local:  npx supabase status -o env  → API_URL / ANON_KEY
# Cloud:  Dashboard → Project Settings → API Keys (publishable or anon key, never the secret key)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: receipt scanning (/scan)
GEMINI_API_KEY=

# Web push (VAPID keys: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared with the database (private.app_settings 'push_secret'); the push sender checks it.
PUSH_WEBHOOK_SECRET=
